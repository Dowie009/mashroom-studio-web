---
// 回遊動線ナビ: 各ページの文脈に合わせた「次の一歩」を3つ提示する共通コンポーネント
interface Item {
    href: string;
    label: string;
    title: string;
    desc: string;
}
const { items } = Astro.props as { items: Item[] };
---

<section class="page-next">
    <p class="page-next-label">NEXT</p>
    <h2 class="page-next-title">次はどこへ？</h2>
    <div class="page-next-grid">
        {items.map((item) => (
            <a href={item.href} class="page-next-card magnet">
                <span class="pn-label">{item.label}</span>
                <span class="pn-title">{item.title}</span>
                <span class="pn-desc">{item.desc}</span>
                <span class="pn-arrow">→</span>
            </a>
        ))}
    </div>
</section>

<style>
    .page-next {
        background: #16161a;
        padding: 70px 5% 80px;
        text-align: center;
        position: relative;
        z-index: 10;
    }
    .page-next-label {
        font-family: 'Archivo Black', 'Arial Black', sans-serif;
        font-size: 0.8rem; letter-spacing: 0.4em;
        color: #ccff00; margin: 0 0 8px;
    }
    .page-next-title {
        font-size: 1.6rem; font-weight: 900; color: #ffffff;
        margin: 0 0 36px; letter-spacing: 0.08em;
    }
    .page-next-grid {
        display: grid; grid-template-columns: repeat(3, 1fr);
        gap: 16px; max-width: 1100px; margin: 0 auto;
    }
    .page-next-card {
        position: relative; display: flex; flex-direction: column; gap: 6px;
        padding: 24px 22px 50px; text-align: left; text-decoration: none;
        background: #ffffff; color: #1a1a1a;
        border: 3px solid #1a1a1a; box-shadow: 6px 6px 0 #ccff00;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .page-next-card:hover { transform: translate(-3px, -3px); box-shadow: 10px 10px 0 #ccff00; }
    .pn-label {
        font-family: 'Archivo Black', 'Arial Black', sans-serif;
        font-size: 0.7rem; letter-spacing: 0.18em; color: #888;
    }
    .pn-title { font-size: 1.1rem; font-weight: 900; line-height: 1.4; }
    .pn-desc { font-size: 0.85rem; line-height: 1.7; color: #555; }
    .pn-arrow {
        position: absolute; right: 18px; bottom: 14px;
        font-size: 1.3rem; font-weight: 900;
        transition: transform 0.2s ease;
    }
    .page-next-card:hover .pn-arrow { transform: translateX(5px); }

    @media (max-width: 1099px) {
        .page-next { padding: 50px 5% 60px; }
        .page-next-grid { grid-template-columns: 1fr; gap: 14px; }
        .page-next-card { padding: 20px 18px 44px; }
    }
</style>
