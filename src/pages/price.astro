---
import Layout from '../layouts/Layout.astro';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/works/', label: 'Works' },
  { href: '/profile/', label: 'Profile' },
  { href: '/gear/', label: 'Gear' },
  { href: '/lesson/', label: 'Lesson' },
  { href: '/price/', label: 'Price', current: true },
  { href: '/#contact', label: 'Contact' },
];

const plans = [
  {
    tag: 'REC',
    title: 'レコーディング',
    price: '¥4,500',
    unit: '/ h',
    accent: '#4bb7c5',
    soft: 'rgba(75, 183, 197, 0.14)',
    text: '歌、弾き語り、ナレーション、デモ制作。エンジニア付きで録音からデータ整理まで対応。',
    items: ['ボーカル録音', '弾き語り', 'ナレーション', '簡易ディレクション'],
  },
  {
    tag: 'STUDENT',
    title: '学生レコーディング',
    price: '¥3,000',
    unit: '/ h',
    accent: '#d6aa55',
    soft: 'rgba(214, 170, 85, 0.16)',
    text: '学生証提示で利用できる初回向けプラン。初めてのスタジオ録音やデモ制作に。',
    items: ['学生証提示', '初録音歓迎', 'データ持ち帰り', '歌ってみた対応'],
    featured: true,
  },
  {
    tag: 'MIX',
    title: 'ミックス',
    price: '¥8,000',
    unit: '〜',
    accent: '#d45c70',
    soft: 'rgba(212, 92, 112, 0.13)',
    text: 'ボーカル、弾き語り、バンド、ナレーションの質感調整。曲数とトラック数で見積もり。',
    items: ['ピッチ編集相談', 'ボーカル処理', 'バンドMix', '修正相談'],
  },
  {
    tag: 'MASTER',
    title: 'マスタリング',
    price: '¥5,000',
    unit: '〜',
    accent: '#75b991',
    soft: 'rgba(117, 185, 145, 0.13)',
    text: '配信、CD、ライブ用音源の最終調整。曲間、音量、聴感の統一まで確認。',
    items: ['配信用', 'CD用', 'ライブSE用', 'ラウドネス確認'],
  },
  {
    tag: 'VISUAL',
    title: 'MV・SNS動画',
    price: '¥15,000',
    unit: '〜',
    accent: '#9d83d4',
    soft: 'rgba(157, 131, 212, 0.13)',
    text: 'スタジオ撮影、演奏動画、SNS用ショート動画。音と映像を同じ場所で相談可能。',
    items: ['スタジオ撮影', 'SNS短尺', 'ライブ配信', '編集相談'],
  },
  {
    tag: 'CONSULT',
    title: '制作相談・DTM',
    price: '¥3,500',
    unit: '/ h',
    accent: '#df8a52',
    soft: 'rgba(223, 138, 82, 0.13)',
    text: '作曲、アレンジ、録音環境、機材購入、活動の見せ方まで。固まっていない段階から相談可。',
    items: ['作曲相談', '機材相談', 'DTM操作', '活動設計'],
  },
];

const rows = [
  ['ボーカル1曲録音', '2〜3h', 'カラオケ音源持ち込み、歌録り、簡易確認まで。'],
  ['弾き語り1曲録音', '3〜4h', 'ギターまたはピアノと歌の同時録音、または別録り。'],
  ['バンド・複数人', '要相談', '編成、ドラム有無、録音方式で大きく変動。'],
  ['歌ってみた一式', '要相談', '録音、ピッチ編集、ミックス、動画用音源まで。'],
  ['企業・CM・映像音楽', '要見積', '尺、使用範囲、納期、修正回数を確認して算出。'],
];

const freebies = ['駐車場', 'Wi-Fi', 'コーヒー', '録音前相談', '機材相談', 'データ整理', 'マイク選定'];
---

<Layout
  title="料金｜札幌北区の録音・ミックス・制作相談 | MASHROOM STUDIO"
  description="MASHROOM STUDIOの料金目安。札幌北区のプライベートスタジオで、レコーディング、ミックス、マスタリング、MV撮影、DTMレッスン、制作相談に対応。学生料金あり。"
  ogImage="/img/price-page-screenshot.jpg"
>
  <main class="veo3-page veo3-price-page">
    <nav class="veo3-nav" aria-label="サイト内ナビゲーション">
      <a class="veo3-brand" href="/">MASHROOM STUDIO</a>
      <div class="veo3-nav-links">
        {nav.map((item) => <a class={item.current ? 'is-current' : ''} href={item.href}>{item.label}</a>)}
      </div>
    </nav>

    <section class="veo3-hero" aria-labelledby="price-title">
      <div class="veo3-hero-media" aria-hidden="true">
        <img src="/img/slides/studio-02.jpg" alt="">
      </div>
      <div class="veo3-hero-content">
        <div>
          <p class="veo3-kicker">05 / PRICE</p>
          <h1 id="price-title">先に目安。<br>細かい見積もりは相談で。</h1>
          <p class="veo3-lede">
            SNSから来た人が一番不安になるのは「いくらかかるか」です。
            ここでは入口の金額を見せて、曲数・録音内容・仕上げ範囲で最終見積もりを出します。
          </p>
          <div class="veo3-actions">
            <a class="veo3-btn veo3-btn-primary" href="/#contact">見積もり相談</a>
            <a class="veo3-btn" href="#plans">料金を見る</a>
          </div>
        </div>
        <aside class="veo3-hero-panel veo3-float">
          <strong>ボーカル1曲の目安</strong>
          <p>録音だけなら2〜3時間。ミックス込みなら、録音後に素材を確認して範囲を決めます。</p>
        </aside>
      </div>
    </section>

    <section class="veo3-section" id="plans" aria-labelledby="plans-title">
      <div class="veo3-section-head veo3-reveal">
        <div>
          <p class="veo3-kicker">MENU</p>
          <h2 id="plans-title">料金メニュー</h2>
        </div>
        <p>金額は「頼めるかどうか」を判断するための入口です。実際の総額は、曲数・トラック数・納期・修正回数で確定します。</p>
      </div>
      <div class="veo3-price-grid">
        {plans.map((plan) => (
          <article
            class={`veo3-price-card ${plan.featured ? 'featured' : ''}`}
            style={`--plan-accent: ${plan.accent}; --plan-soft: ${plan.soft};`}
          >
            <span class="veo3-tag">{plan.tag}</span>
            <h3>{plan.title}</h3>
            <div class="veo3-price">{plan.price}<small>{plan.unit}</small></div>
            <p>{plan.text}</p>
            <ul class="veo3-meta-list">
              {plan.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="veo3-section alt" aria-labelledby="estimate-title">
      <div class="veo3-section-head veo3-reveal">
        <div>
          <p class="veo3-kicker">ESTIMATE</p>
          <h2 id="estimate-title">よくある目安</h2>
        </div>
        <p>「自分の場合いくら？」への答えを先に置きます。ここで完全一致しなくても、相談時の出発点になります。</p>
      </div>
      <div class="veo3-table veo3-reveal" role="table" aria-label="よくある利用例">
        <div class="veo3-table-row veo3-table-head" role="row">
          <span>内容</span><span>時間</span><span>備考</span>
        </div>
        {rows.map(([name, time, note]) => (
          <div class="veo3-table-row" role="row">
            <span>{name}</span>
            <strong>{time}</strong>
            <p>{note}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="veo3-section dark" aria-labelledby="free-title">
      <div class="veo3-section-head veo3-reveal">
        <div>
          <p class="veo3-kicker">INCLUDED</p>
          <h2 id="free-title">無料で含むもの</h2>
        </div>
        <p>スタジオ代の外側で細かく不安になりがちな部分は、なるべく先に見えるようにします。</p>
      </div>
      <div class="veo3-strip veo3-reveal">
        {freebies.map((item) => <span>{item}</span>)}
      </div>
    </section>

    <section class="veo3-cta" aria-labelledby="contact-title">
      <p class="veo3-kicker">CONTACT</p>
      <h2 id="contact-title">金額が読めない案件ほど、先に聞いてください。</h2>
      <p>録りたい内容、曲数、希望日、参考音源、予算感を送ってください。未確定のままでも大丈夫です。</p>
      <div class="veo3-actions">
        <a class="veo3-btn veo3-btn-primary" href="/#contact">相談フォームへ</a>
        <a class="veo3-btn" href="/works/">制作例を見る</a>
      </div>
    </section>

    <nav class="veo3-mobile-cta" aria-label="固定CTA">
      <a href="/works/">実績</a>
      <a href="#plans">料金</a>
      <a href="/#contact">相談</a>
    </nav>
  </main>
</Layout>
