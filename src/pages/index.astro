        @media (max-width: 760px) {
            .v2-br-pc { display: none; }
            .v2-hero { padding: 104px 5% 96px; min-height: 100svh; }
            .v2-hero-facts { gap: 8px; }
            .v2-hero-facts li { padding: 8px 12px; }
