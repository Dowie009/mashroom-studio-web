            background: rgba(255,255,255,0.06); border: 2px solid rgba(255,255,255,0.25); color: #fff;
            font-weight: 700; transition: background 0.2s ease, transform 0.2s ease;
        }
        .v2-alt-btn small { font-weight: 400; font-size: 0.78rem; color: rgba(255,255,255,0.65); }
        .v2-alt-btn:hover { background: rgba(255,255,255,0.14); transform: translateY(-2px); }

        .v2-foot-brand { margin-top: 64px; font-size: 0.72rem; letter-spacing: 0.12em; color: rgba(255,255,255,0.5); }
        .v2-foot-copy { margin-top: 10px; font-size: 0.72rem; color: rgba(255,255,255,0.4); }

        /* ===== モバイル固定CTA ===== */
        .v2-sticky { display: none; }

        /* ===== レスポンシブ ===== */
        @media (max-width: 1099px) {
            .v2-services-grid { grid-template-columns: 1fr; max-width: 460px; }
            .v2-voice-grid { grid-template-columns: 1fr; max-width: 520px; }
