        .v2-voice-attr { font-size: 0.8rem; color: #777; }

        /* ===== 7. FAQ ===== */
        .v2-faq { background: #16161a; padding: 80px 6%; }
        .v2-faq-list { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px; }
