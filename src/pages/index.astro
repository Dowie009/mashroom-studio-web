    <script>
        const qboxToggle = document.getElementById('qbox-toggle');
        const qboxPanel = document.getElementById('qbox-panel');
        const qboxClose = document.getElementById('qbox-close');
        const qboxMessages = document.getElementById('qbox-messages');
        const qboxInput = document.getElementById('qbox-input');
        const qboxSend = document.getElementById('qbox-send');

        function qboxAppend(text, who) {
            const div = document.createElement('div');
            div.className = 'qbox-msg qbox-msg-' + who;
            div.textContent = text;
            qboxMessages.appendChild(div);
            qboxMessages.scrollTop = qboxMessages.scrollHeight;
        }

        qboxToggle.addEventListener('click', () => {
            qboxPanel.classList.toggle('qbox-open');
            qboxPanel.setAttribute('aria-hidden', qboxPanel.classList.contains('qbox-open') ? 'false' : 'true');
        });
        qboxClose.addEventListener('click', () => {
            qboxPanel.classList.remove('qbox-open');
            qboxPanel.setAttribute('aria-hidden', 'true');
        });

        async function sendQuestion(text) {
            const res = await fetch('https://formsubmit.co/ajax/mashibamashiba@gmail.com', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({
                    _subject: '【MASHROOM STUDIO】質問ボックス',
                    message: text,
                    page: location.href
                })
            });
            if (!res.ok) throw new Error('send failed');
        }

        qboxSend.addEventListener('click', async () => {
            const text = qboxInput.value.trim();
            if (!text) return;
            qboxSend.disabled = true;
            qboxAppend(text, 'user');
            qboxInput.value = '';
            try {
                await sendQuestion(text);
                qboxAppend('質問が届きました！ありがとうございます🙌 連絡先が書いてあれば、道ゐから返信します。', 'studio');
            } catch (e) {
                qboxAppend('送信に失敗しました…時間をおいてもう一度試してください。', 'studio');
            } finally {
                qboxSend.disabled = false;
            }
        });

        // フッター埋め込み版の送信
        const fqInput = document.getElementById('footer-qbox-input');
        const fqSend = document.getElementById('footer-qbox-send');
        const fqStatus = document.getElementById('footer-qbox-status');
        fqSend.addEventListener('click', async () => {
            const text = fqInput.value.trim();
            if (!text) return;
            fqSend.disabled = true;
            fqStatus.textContent = '送信中…';
            try {
                await sendQuestion(text);
                fqInput.value = '';
                fqStatus.textContent = '届きました！ありがとうございます🙌 連絡先が書いてあれば返信します。';
            } catch (e) {
                fqStatus.textContent = '送信に失敗しました…時間をおいてもう一度試してください。';
            } finally {
                fqSend.disabled = false;
            }
        });

        // 浮遊ボタンの出現制御:
        // 1画面分スクロールで出現 → フッター（埋め込み版がある場所）が見えたら退場
        const footerEl = document.getElementById('contact');
        let footerInView = false;
        function updateQboxVisibility() {
            const pastHero = window.scrollY > window.innerHeight * 0.8;
            const show = pastHero && !footerInView;
            qboxToggle.classList.toggle('qbox-show', show);
            if (!show) {
                qboxPanel.classList.remove('qbox-open');
                qboxPanel.setAttribute('aria-hidden', 'true');
            }
        }
        new IntersectionObserver((entries) => {
            footerInView = entries[0].isIntersecting;
            updateQboxVisibility();
        }, { threshold: 0.12 }).observe(footerEl);
        window.addEventListener('scroll', updateQboxVisibility, { passive: true });
        updateQboxVisibility();
    </script>

    <!-- MAIL MODAL -->
    <div class="mail-modal-overlay" id="mail-modal-overlay">
