                background: #fff; border: 3px solid var(--c-text); box-shadow: 5px 5px 0 var(--c-text);
                margin-bottom: 16px; padding: 6px 14px;
            }
            .v2-price-table tbody tr:nth-child(odd) td { background: transparent; }
            .v2-price-table td { border: none; padding: 8px 0; display: flex; justify-content: space-between; align-items: baseline; gap: 12px; border-bottom: 1px solid #eee; }
            .v2-price-table td:last-child { border-bottom: none; }
            .v2-price-table td::before { content: attr(data-l); font-size: 0.78rem; color: #888; font-weight: 700; flex-shrink: 0; }
            .v2-price-table td[data-l="やりたいこと"] { font-weight: 900; font-size: 1.08rem; }
            .v2-price-table td[data-l="やりたいこと"]::before { display: none; }

            /* モバイル固定CTA 表示 */
            .v2-sticky {
                display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 0;
                position: fixed; left: 0; right: 0; bottom: 0; z-index: 1400;
                background: var(--c-text); border-top: 2px solid var(--pop-2);
                padding: 0; box-shadow: 0 -4px 16px rgba(0,0,0,0.3);
            }
            .v2-sticky-btn {
                display: flex; align-items: center; justify-content: center; text-align: center;
                padding: 14px 4px; text-decoration: none; font-weight: 900; font-size: 0.88rem;
                color: #fff; border-left: 1px solid rgba(255,255,255,0.18);
            }
            .v2-sticky-btn:first-child { border-left: none; }
            .v2-sticky-main { background: var(--pop-2); color: var(--c-text); }
            /* 固定CTA分の余白をフッターに確保 */
            .v2-contact { padding-bottom: 100px; }
        }
        @media (max-width: 360px) {
            .v2-hero-h1 { font-size: 1.5rem; }
            .v2-sticky-btn { font-size: 0.8rem; }
        }
    </style>

    <script>
        // ===== スクロール出現 =====
        const io = new IntersectionObserver((entries) => {
            entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
        }, { threshold: 0.12 });
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

        // ===== 問い合わせフォーム（FormSubmit経由でGmailに届く） =====
        const form = document.getElementById('v2-form');
        const submitBtn = document.getElementById('v2-submit');
        const statusEl = document.getElementById('v2-status');
        form.addEventListener('submit', async (ev) => {
            ev.preventDefault();
            const name = (document.getElementById('v2-name')).value.trim();
            const contact = (document.getElementById('v2-contact')).value.trim();
            const message = (document.getElementById('v2-msg')).value.trim();
            if (!message && !contact && !name) { statusEl.textContent = '相談内容をひとことだけでも入れてください。'; statusEl.style.color = 'var(--pop-3)'; return; }
            submitBtn.disabled = true;
            statusEl.style.color = 'var(--pop-2)';
            statusEl.textContent = '送信中…';
            try {
                const res = await fetch('https://formsubmit.co/ajax/mashibamashiba@gmail.com', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({
                        _subject: '【MASHROOM STUDIO】サイトからの問い合わせ',
                        name: name || '（未記入）',
                        contact: contact || '（未記入）',
                        message: message || '（未記入）',
                        page: location.href
                    })
                });
                if (!res.ok) throw new Error('failed');
                form.reset();
                statusEl.textContent = '届きました！ありがとうございます🙌 連絡先があれば、道ゐから返信します。';
            } catch (err) {
                statusEl.style.color = 'var(--pop-3)';
                statusEl.textContent = '送信に失敗しました…お手数ですが info@walewalewa.com へ直接ご連絡ください。';
            } finally {
                submitBtn.disabled = false;
            }
        });
    </script>
</Layout>
