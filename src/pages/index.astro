        .v2-field input:focus, .v2-field textarea:focus { outline: 3px solid var(--pop-5); outline-offset: 0; }
        .v2-form-submit { width: 100%; font-size: 1.1rem; padding: 18px; }
        .v2-form-submit:disabled { opacity: 0.55; cursor: wait; }
        .v2-form-status { min-height: 1.4em; margin: 14px 0 0; font-weight: 700; font-size: 0.92rem; color: var(--pop-2); text-align: center; }

        .v2-contact-alt { max-width: 560px; margin: 0 auto; padding-top: 36px; border-top: 1px solid rgba(255,255,255,0.14); }
