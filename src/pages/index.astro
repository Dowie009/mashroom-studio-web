        /* ===== 8. 問い合わせ ===== */
        .v2-contact { background: #0d0d10; padding: 84px 6% 120px; text-align: center; }
        .v2-contact-lead { font-size: 1rem; line-height: 1.85; color: rgba(255,255,255,0.85); margin: 0 0 40px; }
        .v2-form { max-width: 560px; margin: 0 auto 48px; text-align: left; }
        .v2-field { margin-bottom: 18px; }
        .v2-field label { display: block; font-weight: 700; font-size: 0.9rem; color: #fff; margin-bottom: 8px; }
        .v2-opt { font-weight: 400; font-size: 0.78rem; color: rgba(255,255,255,0.55); margin-left: 6px; }
        .v2-field input, .v2-field textarea {
            width: 100%; padding: 13px 15px; font-family: inherit; font-size: 1rem;
