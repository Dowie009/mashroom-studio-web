            .v2-hero-cta { flex-direction: column; gap: 12px; }
            .v2-hero-cta .v2-btn { width: 100%; }
            .v2-clients-grid { grid-template-columns: repeat(2, 1fr); }
            .v2-flow-list { grid-template-columns: 1fr; }
            .v2-contact-alt-row { flex-direction: column; }

            /* 料金表をカード化 */
            .v2-price-table, .v2-price-table tbody, .v2-price-table tr, .v2-price-table td { display: block; width: 100%; }
