      let index = 0;
      window.setInterval(() => {
        slides[index].classList.remove('is-active');
        index = (index + 1) % slides.length;
        slides[index].classList.add('is-active');
      }, 4300);
    };

    rotateSlides('.v3-hero-slide');
    rotateSlides('.v3-studio-slide');

    const rail = document.querySelector('.v3-scroll-rail span');
    let railTicking = false;
    let lastProgress = -1;
    const updateRail = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const progress = max > 0 ? window.scrollY / max : 0;
      const rounded = Math.round(progress * 1000) / 1000;
      if (rounded !== lastProgress) {
        document.querySelector('.v3-home')?.style.setProperty('--v3-scroll', rounded.toFixed(3));
        lastProgress = rounded;
      }
      if (!rail) return;
      rail.style.transform = `scaleY(${Math.max(0.12, progress)})`;
      railTicking = false;
    };
    const requestRail = () => {
      if (railTicking) return;
      railTicking = true;
      window.requestAnimationFrame(updateRail);
    };
    updateRail();
    window.addEventListener('scroll', requestRail, { passive: true });

    document.querySelectorAll('.v3-work-card, .v3-first-grid article, .v3-price-row').forEach((item, index) => {
      if ((index + 1) % 3 === 0) item.classList.add('v3-puzzle-piece');
    });

    const motionTargets = document.querySelectorAll(
      '.v3-section-head, .v3-career-list article, .v3-career-photo, .v3-note-box, .v3-studio-copy, .v3-template'
    );

    if ('IntersectionObserver' in window) {
      motionTargets.forEach((target) => {
        target.style.opacity = '0';
        target.style.transform = 'translateY(34px)';
        target.style.transition = 'opacity 720ms ease, transform 720ms cubic-bezier(0.2, 0.8, 0.2, 1)';
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.16, rootMargin: '0px 0px -8% 0px' });

      motionTargets.forEach((target, index) => {
        target.style.transitionDelay = `${Math.min(index % 5, 4) * 55}ms`;
        observer.observe(target);
      });
    }

    if (!reduceMotion && typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);
      ScrollTrigger.config({ ignoreMobileResize: true });
      gsap.to('.v3-hero-media', {
        xPercent: 4,
        scale: 1.07,
        ease: 'none',
        scrollTrigger: { trigger: '.v3-hero', start: 'top top', end: 'bottom top', scrub: 0.65 }
      });
      gsap.to('.v3-hero-orbit', {
        x: -42,
        rotate: 7,
        ease: 'none',
        scrollTrigger: { trigger: '.v3-hero', start: 'top top', end: 'bottom top', scrub: 0.8 }
      });
      gsap.utils.toArray('.v3-puzzle-piece').forEach((piece, index) => {
        gsap.fromTo(piece,
          {
            x: index % 2 === 0 ? -48 : 48,
            y: 12,
            rotate: index % 2 === 0 ? -1.8 : 1.8,
            clipPath: 'polygon(12% 0, 100% 0, 88% 100%, 0 100%)'
          },
          {
            x: 0,
            y: 0,
            rotate: 0,
            clipPath: 'polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 18px 100%, 0 calc(100% - 18px))',
            duration: 0.95,
            ease: 'expo.out',
            onComplete: () => piece.classList.add('is-set'),
            scrollTrigger: {
              trigger: piece,
              start: 'top 86%',
              toggleActions: 'play none none reverse'
            }
          }
        );
      });
      gsap.utils.toArray('.v3-work-card:not(.v3-puzzle-piece), .v3-first-grid article:not(.v3-puzzle-piece), .v3-price-row:not(.v3-puzzle-piece)').forEach((node, index) => {
        gsap.fromTo(node,
          { x: index % 2 === 0 ? -18 : 18, opacity: 0.88 },
          {
            x: 0,
            opacity: 1,
            duration: 0.62,
            ease: 'power3.out',
            scrollTrigger: { trigger: node, start: 'top 90%', toggleActions: 'play none none none' }
          }
        );
      });
      gsap.utils.toArray('.v3-career-photo img, .v3-studio-slide').forEach((image, index) => {
        gsap.fromTo(image,
          { xPercent: index % 2 === 0 ? -4 : 4, scale: 1.06 },
          {
            xPercent: index % 2 === 0 ? 4 : -4,
            scale: 1.12,
            ease: 'none',
            scrollTrigger: {
              trigger: image.closest('.v3-career-photo, .v3-studio-stage'),
              start: 'top bottom',
              end: 'bottom top',
              scrub: 0.9
            }
          }
        );
      });
      gsap.utils.toArray('.v3-section-head h2, .v3-contact h2').forEach((heading, index) => {
        const puzzle = (index + 1) % 3 === 0;
        gsap.fromTo(heading,
          { clipPath: puzzle ? 'inset(0 0 0 100%)' : 'inset(0 100% 0 0)', x: puzzle ? 28 : -18 },
          {
            clipPath: 'inset(0 0% 0 0)',
            x: 0,
            duration: puzzle ? 1.05 : 0.78,
            ease: puzzle ? 'elastic.out(1, 0.72)' : 'power3.out',
            scrollTrigger: { trigger: heading, start: 'top 84%' }
          }
        );
      });
    }
  </script>
</Layout>
