---
import Layout from '../layouts/Layout.astro';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/works/', label: 'Works' },
  { href: '/profile/', label: 'Profile', current: true },
  { href: '/gear/', label: 'Gear' },
  { href: '/lesson/', label: 'Lesson' },
  { href: '/price/', label: 'Price' },
  { href: '/#contact', label: 'Contact' },
];

const timeline = [
  ['2001', '15歳でDTM・録音を開始。音を作る側の視点を早くから積み上げる。'],
  ['2011', '音楽ユニットでメジャーデビュー。演者側の現場感も経験。'],
  ['Career', 'A-Sketch、Smash Room、Onetrap関連の現場で制作・育成・サポートを経験。'],
  ['Now', '札幌北区の一軒家スタジオ MASHROOM STUDIO を運営。DTM歴24年。'],
];

const achievements = [
  ['協業', 'flumpool 阪井一生、レミオロメン 神宮司治、西川進、亀田誠治、大宮エリー ほか'],
  ['担当', '作曲、編曲、録音、ミックス、マニピュレート、映像音楽、企業案件'],
  ['作品', '北海道コンサドーレ札幌公式アンセム、映画・ドラマ・CM・企業VP関連'],
  ['対象', '地下アイドル、J-pop/ロックバンド、弾き語り、DTM初心者、学生'],
];

const values = [
  ['録る前に整理する', 'キー、テンポ、参考音源、完成イメージを先に確認して、録音時間の迷いを減らします。'],
  ['音楽的に判断する', 'ただ綺麗にするだけでなく、曲の役割、声の魅力、リスナーの聴き方から判断します。'],
  ['活動まで見る', '音源、動画、SNS、ライブ、次の制作まで、必要なら見せ方も一緒に考えます。'],
];
---

<Layout
  title="プロフィール｜真柴道ゐ・札幌の音楽制作 / 録音 | MASHROOM STUDIO"
  description="MASHROOM STUDIO主宰・真柴道ゐのプロフィール。DTM歴24年。札幌北区で録音、ミックス、楽曲制作、映像音楽、DTMレッスン、制作相談に対応。"
  ogImage="/img/image_a2e41c.JPG"
>
  <main class="veo3-page">
    <nav class="veo3-nav" aria-label="サイト内ナビゲーション">
      <a class="veo3-brand" href="/">MASHROOM STUDIO</a>
      <div class="veo3-nav-links">
        {nav.map((item) => <a class={item.current ? 'is-current' : ''} href={item.href}>{item.label}</a>)}
      </div>
    </nav>

    <section class="veo3-hero" aria-labelledby="profile-title">
      <div class="veo3-hero-media" aria-hidden="true">
        <img src="/img/image_a2e41c.JPG" alt="">
      </div>
      <div class="veo3-hero-content">
        <div>
          <p class="veo3-kicker">01 / PROFILE</p>
          <h1 id="profile-title">作る人。録る人。<br>相談に乗る人。</h1>
          <p class="veo3-lede">
            真柴道ゐ。DTM歴24年。アーティスト制作、映画・ドラマ・CM、企業案件で得た判断を、
            札幌北区の小さなプライベートスタジオで使います。
          </p>
          <div class="veo3-actions">
            <a class="veo3-btn veo3-btn-primary" href="/works/">制作実績を見る</a>
            <a class="veo3-btn" href="/#contact">相談する</a>
          </div>
        </div>
        <aside class="veo3-hero-panel veo3-float">
          <strong>一人運営の強み</strong>
          <p>録音、制作、相談の話が途中で分断されません。最初の相談から仕上げまで同じ人が見ます。</p>
        </aside>
      </div>
    </section>

    <section class="veo3-section" aria-labelledby="career-title">
      <div class="veo3-section-head veo3-reveal">
        <div>
          <p class="veo3-kicker">CAREER</p>
          <h2 id="career-title">経歴</h2>
        </div>
        <p>長い自分語りではなく、依頼者が判断できる材料だけを前に出します。</p>
      </div>
      <div class="veo3-grid four">
        {timeline.map(([year, text]) => (
          <article class="veo3-step veo3-reveal">
            <span class="veo3-tag">{year}</span>
            <h3>{year}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="veo3-section alt" aria-labelledby="achievement-title">
      <div class="veo3-split">
        <div class="veo3-copy veo3-reveal">
          <p class="veo3-kicker">ACHIEVEMENT</p>
          <h2 id="achievement-title">有名な実績は、信頼の入口。</h2>
          <p>ただし、来てくれる人に必要なのは「自分の曲もちゃんと見てもらえるか」です。大きい現場で学んだ判断を、個人制作や初めての録音に落とし込みます。</p>
          <ul class="veo3-list">
            {achievements.map(([label, text]) => <li><strong>{label}</strong> / {text}</li>)}
          </ul>
        </div>
        <div class="veo3-photo veo3-reveal veo3-float">
          <img src="/img/slides/studio-06.jpg" alt="MASHROOM STUDIO 第3スタジオとは別の制作スペース写真" loading="lazy">
        </div>
      </div>
    </section>

    <section class="veo3-section dark" aria-labelledby="style-title">
      <div class="veo3-section-head veo3-reveal">
        <div>
          <p class="veo3-kicker">STYLE</p>
          <h2 id="style-title">制作の見方</h2>
        </div>
        <p>初めての人にも、経験者にも、必要なのは「ちゃんと話が通じる制作環境」です。</p>
      </div>
      <div class="veo3-grid">
        {values.map(([title, text]) => (
          <article class="veo3-feature veo3-reveal">
            <span class="veo3-tag">{title}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="veo3-cta" aria-labelledby="contact-title">
      <p class="veo3-kicker">CONTACT</p>
      <h2 id="contact-title">会う前に、音源だけ送っても大丈夫です。</h2>
      <p>デモ、参考曲、やりたいこと、困っていること。文章がまとまっていなくても、そこから整理します。</p>
      <div class="veo3-actions">
        <a class="veo3-btn veo3-btn-primary" href="/#contact">相談する</a>
        <a class="veo3-btn" href="/price/">料金を見る</a>
      </div>
    </section>

    <nav class="veo3-mobile-cta" aria-label="固定CTA">
      <a href="/works/">実績</a>
      <a href="/price/">料金</a>
      <a href="/#contact">相談</a>
    </nav>
  </main>
</Layout>
