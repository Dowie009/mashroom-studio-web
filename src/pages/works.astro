---
import Layout from '../layouts/Layout.astro';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/works/', label: 'Works', current: true },
  { href: '/profile/', label: 'Profile' },
  { href: '/gear/', label: 'Gear' },
  { href: '/lesson/', label: 'Lesson' },
  { href: '/price/', label: 'Price' },
  { href: '/#contact', label: 'Contact' },
];

const works = [
  {
    tag: 'ANTHEM / PRODUCE',
    title: '北海道コンサドーレ札幌',
    image: '/img/image_a03d20.png',
    text: '公式アンセム関連、メンバー紹介BGM、会場映像BGMなど。大きい会場で鳴るロックとして設計。',
  },
  {
    tag: 'DRAMA / COMPOSE',
    title: 'TBS「対岸の家事」',
    image: '/img/image_a03568.jpg',
    text: 'flumpool 阪井一生氏と共同作曲。劇伴制作、音色作り、マニピュレートまで担当。',
  },
  {
    tag: 'FILM / MANIPULATE',
    title: '映画「天間荘の三姉妹」',
    image: '/img/image_a035c2.jpg',
    text: '松本晃彦氏の制作チームでマニピュレート。映画音楽の制作現場で得た判断力をスタジオワークに還元。',
  },
  {
    tag: 'ARTIST / REC',
    title: 'Chevon',
    image: '/img/Chevon.jpg',
    text: '初期のサウンドプロデュース、レコーディング、マニピュレートを担当。',
  },
  {
    tag: 'CM / BGM',
    title: 'LeTAO / 札幌PARCO / 雪印関連',
    image: '/img/L_Logo.jpeg',
    text: 'WebCM、企業VP、イベント音楽、ナレーション録音など、企業案件の音まわりを制作。',
  },
  {
    tag: 'MIX / MASTER',
    title: 'アーティスト音源制作',
    image: '/img/slides/studio-02.jpg',
    text: '地下アイドル、J-pop/ロックバンド、弾き語り、歌ってみた、デモ音源まで幅広く対応。',
  },
];

const services = [
  ['歌録り', 'マイク選び、録音、簡易ディレクション、データ整理。'],
  ['ミックス', '声を前に出す、バンドを整理する、配信用に仕上げる。'],
  ['映像音楽', 'CM、ドラマ、映画、イベントの尺と感情に合わせる。'],
  ['ブランディング', '音源、写真、動画、SNSの見せ方をまとめて相談。'],
];

const clients = ['flumpool', 'Chevon', 'TRIPLANE', 'Rihwa', '北海道コンサドーレ札幌', 'TBS', 'LeTAO', '札幌PARCO', '雪印', 'AKTIO'];
---

<Layout
  title="制作実績｜札幌の録音・楽曲制作・CM音楽 | MASHROOM STUDIO"
  description="MASHROOM STUDIOの制作実績。北海道コンサドーレ札幌、TBSドラマ、映画音楽、CM音楽、アーティスト制作、レコーディング、ミックスに対応。札幌北区のプライベートスタジオ。"
  ogImage="/img/works-page-screenshot.jpg"
>
  <main class="veo3-page">
    <nav class="veo3-nav" aria-label="サイト内ナビゲーション">
      <a class="veo3-brand" href="/">MASHROOM STUDIO</a>
      <div class="veo3-nav-links">
        {nav.map((item) => <a class={item.current ? 'is-current' : ''} href={item.href}>{item.label}</a>)}
      </div>
    </nav>

    <section class="veo3-hero" aria-labelledby="works-title">
      <div class="veo3-hero-media" aria-hidden="true">
        <img src="/img/missions/real-rec.jpg" alt="">
      </div>
      <div class="veo3-hero-content">
        <div>
          <p class="veo3-kicker">02 / WORKS</p>
          <h1 id="works-title">派手な肩書きより、<br>何を任せられるか。</h1>
          <p class="veo3-lede">
            アーティスト制作、映像音楽、CM、企業VP、地下アイドル、弾き語りまで。
            実績は信頼の材料として、依頼できる内容が見えるように並べます。
          </p>
          <div class="veo3-actions">
            <a class="veo3-btn veo3-btn-primary" href="/#contact">制作を相談する</a>
            <a class="veo3-btn" href="#selected">実績を見る</a>
          </div>
        </div>
        <aside class="veo3-hero-panel veo3-float">
          <strong>強いところ</strong>
          <p>録音、作曲、アレンジ、ミックス、映像音楽、活動相談を分断せずに見られること。</p>
        </aside>
      </div>
    </section>

    <div class="veo3-marquee" aria-hidden="true">
      <div class="veo3-marquee-track">
        {[...clients, ...clients].map((client) => <span>{client}</span>)}
      </div>
    </div>

    <section class="veo3-section" id="selected" aria-labelledby="selected-title">
      <div class="veo3-section-head veo3-reveal">
        <div>
          <p class="veo3-kicker">SELECTED</p>
          <h2 id="selected-title">担当作品</h2>
        </div>
        <p>有名案件だけを大きく見せるのではなく、担当した領域と依頼の入口が伝わる形に整理しています。</p>
      </div>
      <div class="veo3-grid">
        {works.map((work) => (
          <article class="veo3-card veo3-reveal">
            <div class="veo3-card-image wide">
              <img src={work.image} alt={work.title} loading="lazy">
            </div>
            <div class="veo3-card-body">
              <span class="veo3-tag">{work.tag}</span>
              <h3>{work.title}</h3>
              <p>{work.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="veo3-section alt" aria-labelledby="service-title">
      <div class="veo3-section-head veo3-reveal">
        <div>
          <p class="veo3-kicker">REQUEST</p>
          <h2 id="service-title">頼めること</h2>
        </div>
        <p>「実績がある人」より、「今の自分の曲をどう助けてくれるか」が大事です。入口はこの4つに分けます。</p>
      </div>
      <div class="veo3-grid four">
        {services.map(([title, text]) => (
          <article class="veo3-feature veo3-reveal">
            <span class="veo3-tag">{title}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="veo3-section dark" aria-labelledby="studio-title">
      <div class="veo3-split">
        <div class="veo3-photo veo3-reveal veo3-float">
          <img src="/img/slides/studio-06.jpg" alt="MASHROOM STUDIOの制作スペース" loading="lazy">
        </div>
        <div class="veo3-copy veo3-reveal">
          <p class="veo3-kicker">PRIVATE STUDIO</p>
          <h2 id="studio-title">大きい現場の判断を、小さい部屋に持ち込む。</h2>
          <p>一軒家のプライベートスタジオなので、商業スタジオの緊張感よりも、話しながら詰める時間を作りやすい。初めての録音でも、制作経験者でも、必要な判断だけを一緒に整理します。</p>
          <div class="veo3-card-actions">
            <a class="veo3-btn veo3-btn-primary" href="/price/">料金を見る</a>
            <a class="veo3-btn" href="/gear/">機材を見る</a>
          </div>
        </div>
      </div>
    </section>

    <section class="veo3-cta" aria-labelledby="contact-title">
      <p class="veo3-kicker">CONTACT</p>
      <h2 id="contact-title">近い実績がなくても、まず音源を送ってください。</h2>
      <p>やりたいこと、参考音源、今のデモ、希望日、予算感。未完成で問題ありません。</p>
      <div class="veo3-actions">
        <a class="veo3-btn veo3-btn-primary" href="/#contact">相談する</a>
        <a class="veo3-btn" href="/price/">料金を見る</a>
      </div>
    </section>

    <nav class="veo3-mobile-cta" aria-label="固定CTA">
      <a href="#selected">実績</a>
      <a href="/price/">料金</a>
      <a href="/#contact">相談</a>
    </nav>
  </main>
</Layout>
