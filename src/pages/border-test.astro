---
// ボーダースタイル比較デモ（一時ページ）
// https://xn--3-sj5c.jp/border-test/ でiPhoneから5種類を見比べる用
---

<!doctype html>
<html lang="ja">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Border Test｜MASHROOM STUDIO</title>
    <style>
        :root {
            --bg: #111;
            --card: #1a1a1a;
            --lime: #b9ff66;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: var(--bg);
            color: #fff;
            font-family: "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Zen Kaku Gothic New", sans-serif;
            -webkit-font-smoothing: antialiased;
            padding: 24px 18px 80px;
            line-height: 1.6;
        }
        .back {
            display: inline-block;
            color: var(--lime);
            text-decoration: none;
            font-weight: 700;
            font-size: 0.95rem;
            margin-bottom: 24px;
            letter-spacing: 0.02em;
        }
        .back:hover { text-decoration: underline; }
        .page-title {
            font-size: 1.3rem;
            font-weight: 900;
            margin-bottom: 6px;
        }
        .page-note {
            font-size: 0.85rem;
            color: rgba(255,255,255,0.6);
            margin-bottom: 32px;
        }
        .demo {
            max-width: 480px;
            margin: 0 auto;
        }
        .style-label {
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--lime);
            letter-spacing: 0.06em;
            margin: 0 0 10px 2px;
        }
        .style-label small {
            display: block;
            color: rgba(255,255,255,0.5);
            font-weight: 400;
            font-size: 0.72rem;
            letter-spacing: 0;
            margin-top: 2px;
        }
        .card {
            background: var(--card);
            padding: 26px 22px;
            margin-bottom: 44px;
        }
        .card-main {
            font-size: 1.2rem;
            font-weight: 900;
            line-height: 1.5;
        }
        .card-sub {
            margin-top: 12px;
            font-size: 0.95rem;
            font-family: "Share Tech Mono", monospace;
            color: var(--lime);
        }

        /* ① 現在（ストレート） */
        .s1 { border: 3px solid var(--lime); }

        /* ② feTurbulence マイルド */
        .s2 { border: 3px solid var(--lime); filter: url(#fm); }

        /* ③ feTurbulence ストロング */
        .s3 { border: 3px solid var(--lime); filter: url(#fs); }

        /* ④ マルチカラー shadow */
        .s4 { border: 2px solid var(--lime); box-shadow: 4px 4px 0 #ff006e, -3px -3px 0 #00f5d4; }

        /* ⑤ 同色ブレ shadow */
        .s5 {
            border: 2px solid var(--lime);
            box-shadow: 2px 3px 0 rgba(185,255,102,.5), -2px -2px 0 rgba(185,255,102,.3), 4px 5px 0 rgba(185,255,102,.15);
        }

        /* ── CSS-only 代替案 区切り ── */
        .divider {
            text-align: center;
            color: #777;
            font-size: 0.95rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            margin: 8px 0 36px;
        }
        .style-label .desc { color: #777; }

        /* CSS-A: 非対称 border-radius */
        .cssA {
            border: 3px solid var(--lime);
            border-radius: 2px 9px 3px 8px / 7px 2px 8px 3px;
        }

        /* CSS-B: clip-path 不規則ポリゴン（ラッパー＋内側） */
        .cssB-wrap {
            background: #b9ff66;
            padding: 3px;
            margin-bottom: 44px;
            clip-path: polygon(0.5% 2%, 2% 0.5%, 97.5% 1%, 100% 2.5%, 99% 98%, 97.5% 99.5%, 2% 99%, 0% 97%);
        }
        .cssB-inner {
            background: #1a1a1a;
            padding: 16px 18px;
            clip-path: polygon(0.5% 3%, 3% 0.5%, 97% 1.5%, 99.5% 3%, 98.5% 97%, 97% 99%, 3% 98.5%, 0.5% 96%);
        }

        /* CSS-C: box-shadow 多重ライム */
        .cssC {
            background: #1a1a1a;
            border-radius: 4px;
            border: 2px solid var(--lime);
            box-shadow: 3px 3px 0 #b9ff66, -2px -2px 0 rgba(185,255,102,0.5), 5px 5px 0 rgba(185,255,102,0.2);
        }

        /* ── 2026年 先進技術デモ 共通テキスト ── */
        .bt-main { color: #b9ff66; font-size: 1.2rem; font-weight: 900; line-height: 1.5; }
        .bt-sub { margin-top: 12px; color: #777; font-size: 0.95rem; font-family: "Share Tech Mono", monospace; }

        /* D① 呼吸する枠 — animated feTurbulence */
        .bt-breathe {
            background: #1a1a1a; padding: 16px 18px; border-radius: 6px;
            border: 3px solid #b9ff66; filter: url(#breathe);
            margin-bottom: 44px;
        }

        /* D④ 光が一周する枠 — CSS @property + conic-gradient */
        @property --bt-ang {
            syntax: '<angle>';
            initial-value: 0deg;
            inherits: false;
        }
        @keyframes bt-spin { to { --bt-ang: 360deg; } }
        .bt-conic {
            background:
                linear-gradient(#1a1a1a, #1a1a1a) padding-box,
                conic-gradient(from var(--bt-ang), transparent 0deg, #b9ff66 90deg, transparent 180deg) border-box;
            border: 3px solid transparent;
            border-radius: 6px;
            animation: bt-spin 2.8s linear infinite;
            margin-bottom: 44px;
        }
    </style>
</head>
<body>
    <!-- ②③用 SVGフィルター定義（画面には表示しない） -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <defs>
            <filter id="fm">
                <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="4" result="noise" />
                <feDisplacementMap in="SourceGraphic" in2="noise" scale="3" xChannelSelector="R" yChannelSelector="G" />
            </filter>
            <filter id="fs">
                <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="3" result="noise" />
                <feDisplacementMap in="SourceGraphic" in2="noise" scale="9" xChannelSelector="R" yChannelSelector="G" />
            </filter>
        </defs>
    </svg>

    <!-- D①用: 呼吸する枠フィルター（animated feTurbulence） -->
    <svg width="0" height="0" style="position:absolute;overflow:hidden">
        <defs>
            <filter id="breathe" x="-10%" y="-10%" width="120%" height="120%">
                <feTurbulence type="fractalNoise" baseFrequency="0.030" numOctaves="4" seed="5" result="n">
                    <animate attributeName="baseFrequency" values="0.018;0.050;0.018" dur="3s" repeatCount="indefinite" />
                </feTurbulence>
                <feDisplacementMap in="SourceGraphic" in2="n" scale="5" xChannelSelector="R" yChannelSelector="G" />
            </filter>
        </defs>
    </svg>

    <a href="/" class="back">← トップに戻る</a>
    <h1 class="page-title">ボーダースタイル比較</h1>
    <p class="page-note">5種類の枠線スタイルを見比べる一時ページです。</p>

    <div class="demo">
        <p class="style-label">① 現在（ストレート）<small>border: 3px solid #b9ff66</small></p>
        <div class="card s1">
            <p class="card-main">歌いたい、録りたい。それだけでOK。</p>
            <p class="card-sub">¥4,500/h · 学生 ¥3,000/h</p>
        </div>

        <p class="style-label">② feTurbulence マイルド<small>filter: url(#fm) · scale=3, baseFreq=0.035, octaves=4</small></p>
        <div class="card s2">
            <p class="card-main">歌いたい、録りたい。それだけでOK。</p>
            <p class="card-sub">¥4,500/h · 学生 ¥3,000/h</p>
        </div>

        <p class="style-label">③ feTurbulence ストロング<small>filter: url(#fs) · scale=9, baseFreq=0.04, octaves=3</small></p>
        <div class="card s3">
            <p class="card-main">歌いたい、録りたい。それだけでOK。</p>
            <p class="card-sub">¥4,500/h · 学生 ¥3,000/h</p>
        </div>

        <p class="style-label">④ マルチカラー shadow<small>border 2px + box-shadow #ff006e / #00f5d4</small></p>
        <div class="card s4">
            <p class="card-main">歌いたい、録りたい。それだけでOK。</p>
            <p class="card-sub">¥4,500/h · 学生 ¥3,000/h</p>
        </div>

        <p class="style-label">⑤ 同色ブレ shadow<small>border 2px + 多重 box-shadow（同色・段階透明度）</small></p>
        <div class="card s5">
            <p class="card-main">歌いたい、録りたい。それだけでOK。</p>
            <p class="card-sub">¥4,500/h · 学生 ¥3,000/h</p>
        </div>

        <p class="divider">── CSS-only 代替案 ──</p>

        <p class="style-label">A — 非対称 border-radius（有機的な多角形）<small class="desc">純CSS。角が非対称でゆるい多角形感。軽量。</small></p>
        <div class="card cssA">
            <p class="card-main">歌いたい、録りたい。それだけでOK。</p>
            <p class="card-sub">¥4,500/h · 学生 ¥3,000/h</p>
        </div>

        <p class="style-label">B — clip-path 不規則ポリゴン（切り抜き枠）<small class="desc">純CSS。枠幅は均一でエッジがジャギー気味の多角形。</small></p>
        <div class="cssB-wrap">
            <div class="cssB-inner">
                <p class="card-main">歌いたい、録りたい。それだけでOK。</p>
                <p class="card-sub">¥4,500/h · 学生 ¥3,000/h</p>
            </div>
        </div>

        <p class="style-label">C — box-shadow 多重ライム（重ね影）<small class="desc">純CSS。ライムの影が段々滲む感じ。エネルギッシュ。</small></p>
        <div class="card cssC">
            <p class="card-main">歌いたい、録りたい。それだけでOK。</p>
            <p class="card-sub">¥4,500/h · 学生 ¥3,000/h</p>
        </div>

        <p class="divider">── 2026年 先進技術デモ ──</p>

        <p class="style-label">D① 呼吸する枠 — animated feTurbulence<small class="desc">枠が生き物のようにゆらぐ。ページを開いた瞬間から動く。</small></p>
        <div class="bt-breathe">
            <p class="bt-main">歌いたい、録りたい。それだけでOK。</p>
            <p class="bt-sub">¥4,500/h · 学生 ¥3,000/h</p>
        </div>

        <p class="style-label">D② ペンで描かれる枠 — SVG stroke-dashoffset<small class="desc">スクロール流入の瞬間に枠が描かれる。署名のような演出。（タップで再生）</small></p>
        <div style="position:relative;cursor:pointer;margin-bottom:44px" id="bt-dw">
            <div id="bt-dc" style="background:#1a1a1a;padding:16px 18px;border-radius:6px">
                <p class="bt-main">歌いたい、録りたい。それだけでOK。</p>
                <p class="bt-sub">¥4,500/h · 学生 ¥3,000/h</p>
            </div>
            <svg id="bt-ds" style="position:absolute;top:0;left:0;pointer-events:none;overflow:visible">
                <rect id="bt-dr" fill="none" stroke="#b9ff66" stroke-width="3" rx="6" />
            </svg>
        </div>

        <p class="style-label">D③ 本物の手描き枠 — Rough.js<small class="desc">Rough.jsがランダムな手描きSVGパスを生成。タップのたびに違う線になる。</small></p>
        <div style="position:relative;cursor:pointer;margin-bottom:44px" id="bt-rw">
            <div id="bt-rc" style="background:#1a1a1a;padding:16px 18px;border-radius:6px">
                <p class="bt-main">歌いたい、録りたい。それだけでOK。</p>
                <p class="bt-sub">¥4,500/h · 学生 ¥3,000/h</p>
            </div>
            <svg id="bt-rs" style="position:absolute;top:0;left:0;pointer-events:none;overflow:visible"></svg>
        </div>

        <p class="style-label">D④ 光が一周する枠 — CSS @property + conic-gradient<small class="desc">CSS @property で角度をアニメーション。ライムの光が枠をぐるぐる一周。2025〜26年のCSSにしか出来ない技。</small></p>
        <div class="bt-conic" style="padding:16px 18px">
            <p class="bt-main">歌いたい、録りたい。それだけでOK。</p>
            <p class="bt-sub">¥4,500/h · 学生 ¥3,000/h</p>
        </div>
    </div>

    <script is:inline src="https://unpkg.com/roughjs@4.6.6/bundled/rough.js"></script>
    <script is:inline>
        function btPlayDraw() {
            var c = document.getElementById('bt-dc'), s = document.getElementById('bt-ds'), r = document.getElementById('bt-dr');
            if (!c || !s || !r) return;
            var w = c.offsetWidth, h = c.offsetHeight;
            s.setAttribute('width', w); s.setAttribute('height', h); s.setAttribute('viewBox', '0 0 ' + w + ' ' + h);
            r.setAttribute('x', '2'); r.setAttribute('y', '2'); r.setAttribute('width', w - 4); r.setAttribute('height', h - 4);
            var p = 2 * (w + h);
            r.style.transition = 'none'; r.style.strokeDasharray = p; r.style.strokeDashoffset = p;
            requestAnimationFrame(function () { requestAnimationFrame(function () {
                r.style.transition = 'stroke-dashoffset 2s cubic-bezier(.4,0,.2,1)'; r.style.strokeDashoffset = '0';
            }); });
        }
        function btDrawRough() {
            if (typeof rough === 'undefined') { setTimeout(btDrawRough, 200); return; }
            var c = document.getElementById('bt-rc'), s = document.getElementById('bt-rs');
            if (!c || !s) return;
            while (s.firstChild) s.removeChild(s.firstChild);
            var w = c.offsetWidth, h = c.offsetHeight;
            s.setAttribute('width', w); s.setAttribute('height', h); s.setAttribute('viewBox', '0 0 ' + w + ' ' + h);
            var rc = rough.svg(s);
            s.appendChild(rc.rectangle(3, 3, w - 6, h - 6, { stroke: '#b9ff66', strokeWidth: 2.5, roughness: 2.8, bowing: 2, fill: 'none' }));
        }
        document.addEventListener('DOMContentLoaded', function () {
            btPlayDraw();
            document.getElementById('bt-dw').addEventListener('click', btPlayDraw);
            btDrawRough();
            document.getElementById('bt-rw').addEventListener('click', btDrawRough);
        });
        // フォント読込・回転でサイズが変わったら枠を引き直す
        window.addEventListener('resize', function () { btPlayDraw(); btDrawRough(); });
    </script>
</body>
</html>
