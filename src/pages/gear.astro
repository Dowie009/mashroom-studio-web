---
import Layout from '../layouts/Layout.astro';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/works/', label: 'Works' },
  { href: '/profile/', label: 'Profile' },
  { href: '/gear/', label: 'Gear', current: true },
  { href: '/lesson/', label: 'Lesson' },
  { href: '/price/', label: 'Price' },
  { href: '/#contact', label: 'Contact' },
];

const gear = [
  {
    group: 'Monitor',
    name: 'Genelec 8351A',
    image: '/img/Genelec8351A.jpg',
    text: '同軸3Wayモニター。低域、声、奥行きの判断を正確にし、ミックスの迷いを減らします。',
  },
  {
    group: 'Mic',
    name: 'LEWITT PURE TUBE',
    image: '/img/LEWITTPureTube.jpg',
    text: '真空管コンデンサーマイク。ボーカルの温度感と近さを作りたい録音で主力になります。',
  },
  {
    group: 'System',
    name: 'Mac Studio M4 Max',
    image: '/img/01Mac.jpg',
    text: '大きいセッション、映像編集、複数プラグイン処理に耐える制作環境。',
  },
  {
    group: 'Interface',
    name: 'Apollo x4',
    image: '/img/02X4.jpg',
    text: 'UAD環境で録音中の質感作りにも対応。声の返しを作り込みやすい機材です。',
  },
  {
    group: 'Visual',
    name: 'FUJIFILM X-T4',
    image: '/img/06XT4.jpeg',
    text: 'MV、SNS動画、配信用素材の撮影に対応。音源と映像の空気を揃えます。',
  },
  {
    group: 'Workflow',
    name: '49 inch OLED + Stream Deck',
    image: '/img/JAPANNEXT Ultra Wide.jpg',
    text: 'DAW、映像、資料を並べて確認できる作業環境。録音中の判断と修正が速くなります。',
  },
];

const software = ['Studio One', 'Pro Tools', 'Cubase', 'UAD', 'iZotope Ozone', 'KOMPLETE', 'Superior Drummer 3', 'BFD3', 'Keyscape', 'EZbass'];
---

<Layout
  title="機材｜札幌の録音・ミックス制作環境 | MASHROOM STUDIO"
  description="MASHROOM STUDIOの機材紹介。Genelec 8351A、LEWITT PURE TUBE、Apollo x4、Mac Studio、FUJIFILM X-T4など、録音・ミックス・映像制作に対応する環境。"
  ogImage="/img/gear-page-screenshot.jpg"
>
  <main class="veo3-page">
    <nav class="veo3-nav" aria-label="サイト内ナビゲーション">
      <a class="veo3-brand" href="/">MASHROOM STUDIO</a>
      <div class="veo3-nav-links">
        {nav.map((item) => <a class={item.current ? 'is-current' : ''} href={item.href}>{item.label}</a>)}
      </div>
    </nav>

    <section class="veo3-hero" aria-labelledby="gear-title">
      <div class="veo3-hero-media" aria-hidden="true">
        <img src="/img/slides/studio-02.jpg" alt="">
      </div>
      <div class="veo3-hero-content">
        <div>
          <p class="veo3-kicker">04 / GEAR</p>
          <h1 id="gear-title">機材は自慢ではなく、<br>判断の精度です。</h1>
          <p class="veo3-lede">
            マイク、モニター、DAW、映像機材。全部の目的はひとつです。
            録った声や演奏が、外で聴いてもちゃんと届く状態にすること。
          </p>
          <div class="veo3-actions">
            <a class="veo3-btn veo3-btn-primary" href="/#contact">録音を相談する</a>
            <a class="veo3-btn" href="#gear-list">機材を見る</a>
          </div>
        </div>
        <aside class="veo3-hero-panel veo3-float">
          <strong>見るべきポイント</strong>
          <p>高い機材があるかより、録る・聴く・直す判断が同じ場所でできるか。</p>
        </aside>
      </div>
    </section>

    <section class="veo3-section" id="gear-list" aria-labelledby="gear-list-title">
      <div class="veo3-section-head veo3-reveal">
        <div>
          <p class="veo3-kicker">CORE GEAR</p>
          <h2 id="gear-list-title">音と映像の入口</h2>
        </div>
        <p>スペック表だけでは依頼者には伝わりません。ここでは「何に効く機材か」を先に書きます。</p>
      </div>
      <div class="veo3-grid">
        {gear.map((item) => (
          <article class="veo3-card veo3-reveal">
            <div class="veo3-card-image">
              <img src={item.image} alt={item.name} loading="lazy">
            </div>
            <div class="veo3-card-body">
              <span class="veo3-tag">{item.group}</span>
              <h3>{item.name}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="veo3-section alt" aria-labelledby="software-title">
      <div class="veo3-section-head veo3-reveal">
        <div>
          <p class="veo3-kicker">SOFTWARE</p>
          <h2 id="software-title">制作ソフト</h2>
        </div>
        <p>持ち込みデータや制作相談に対応しやすいよう、複数のDAWと音源・プラグインを使い分けます。</p>
      </div>
      <div class="veo3-strip veo3-reveal">
        {software.map((item) => <span>{item}</span>)}
      </div>
    </section>

    <section class="veo3-section dark" aria-labelledby="room-title">
      <div class="veo3-split">
        <div class="veo3-photo veo3-reveal veo3-float">
          <img src="/img/slides/studio-05.jpg" alt="スタジオ機材と制作スペース" loading="lazy">
        </div>
        <div class="veo3-copy veo3-reveal">
          <p class="veo3-kicker">ROOM</p>
          <h2 id="room-title">一軒家スタジオの距離感。</h2>
          <p>大きい商業スタジオより、相談しながら詰めやすい距離を大事にしています。録音、撮影、配信、機材相談まで、同じ部屋で切り替えられることが強みです。</p>
          <div class="veo3-card-actions">
            <a class="veo3-btn veo3-btn-primary" href="/price/">料金を見る</a>
            <a class="veo3-btn" href="/works/">制作実績を見る</a>
          </div>
        </div>
      </div>
    </section>

    <section class="veo3-cta" aria-labelledby="contact-title">
      <p class="veo3-kicker">CONTACT</p>
      <h2 id="contact-title">機材名がわからなくても、音の希望で相談してください。</h2>
      <p>「近い声にしたい」「ロックっぽくしたい」「配信で聴きやすくしたい」くらいの言葉で十分です。</p>
      <div class="veo3-actions">
        <a class="veo3-btn veo3-btn-primary" href="/#contact">相談する</a>
        <a class="veo3-btn" href="/price/">料金を見る</a>
      </div>
    </section>

    <nav class="veo3-mobile-cta" aria-label="固定CTA">
      <a href="/works/">実績</a>
      <a href="/price/">料金</a>
      <a href="/#contact">相談</a>
    </nav>
  </main>
</Layout>
